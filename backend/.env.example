PORT=4000
NODE_ENV=development

# Generate a Stellar testnet keypair at https://laboratory.stellar.org
STELLAR_WEB_AUTH_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Any random string — used to sign JWT session tokens
JWT_SECRET=change-me-to-a-long-random-secret

# Frontend origin for CORS
CLIENT_ORIGIN=http://localhost:3000

# Soroban / Stellar testnet RPC
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Deployed contract addresses (fill after running: stellar contract deploy)
ESCROW_CONTRACT_ID=
G2S_TOKEN_CONTRACT_ID=
